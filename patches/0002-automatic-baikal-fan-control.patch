+/* Pure fan policy; timestamps are monotonic seconds. */
+#ifndef BAIKAL_FAN_POLICY_H
+#define BAIKAL_FAN_POLICY_H
+#include <stdbool.h>
+#include <stdint.h>
+#define BAIKAL_FAN_STALE_SECONDS 15
+#define BAIKAL_FAN_HOLD_SECONDS 60
+struct baikal_fan_policy { uint64_t cool_since; bool cooling; };
+static inline int baikal_fan_target(int temp)
+{
+    if (temp >= 51) return 100;
+    if (temp >= 48) return 65;
+    if (temp >= 45) return 40;
+    if (temp >= 40) return 25;
+    return 10;
+}
+static inline int baikal_fan_lower_boundary(int fan)
+{
+    if (fan >= 100) return 51;
+    if (fan >= 65) return 48;
+    if (fan >= 40) return 45;
+    if (fan >= 25) return 40;
+    return 0;
+}
+static inline int baikal_fan_next(struct baikal_fan_policy *p, int current,
+                                int hottest, bool valid, uint64_t now)
+{
+    int target = valid ? baikal_fan_target(hottest) : 100;
+    if (!valid || target >= current) { p->cooling = false; return target; }
+    if (hottest > baikal_fan_lower_boundary(current) - 2) {
+        p->cooling = false;
+        return current;
+    }
+    if (!p->cooling) { p->cooling = true; p->cool_since = now; }
+    if (now - p->cool_since < BAIKAL_FAN_HOLD_SECONDS) return current;
+    p->cooling = false;
+    if (current > 65) return 65;
+    if (current > 40) return 40;
+    if (current > 25) return 25;
+    return 10;
+}
+#endif
diff --git a/tests/baikal-fan-test.c b/tests/baikal-fan-test.c
new file mode 100644
index 0000000..2991a8e
--- /dev/null
+++ b/tests/baikal-fan-test.c
@@ -0,0 +1,178 @@
+/* Offline tests exercise the actual driver with a mocked USB transport. */
+#include "../driver-baikalu.c"
+#include <assert.h>
+
+bool opt_debug, use_syslog, opt_log_output;
+int opt_log_level = LOG_ERR;
+static uint64_t fake_now = 1000;
+static int fail_id = -1, bad_reply, short_write, writes;
+static uint8_t last[15], history[64][15];
+
+void cgtimer_time(cgtimer_t *now) { now->tv_sec = fake_now; now->tv_nsec = 0; }
+void _applog(int priority, const char *str, bool force) { (void)priority; (void)str; (void)force; }
+void _quit(int status) { exit(status); }
+void cgsleep_ms(int ms)
+{
+    struct timespec wait = {0, (ms > 0 ? 1000000 : 0)};
+    nanosleep(&wait, NULL);
+}
+
+int _usb_write(struct cgpu_info *cgpu, int ii, int ep, char *buf,
+               size_t size, int *processed, int timeout, enum usb_cmds cmd)
+{
+    (void)cgpu; (void)ii; (void)ep; (void)timeout; (void)cmd;
+    assert(size == 15);
+    memcpy(last, buf, size);
+    assert(writes < 64);
+    memcpy(history[writes++], buf, size);
+    *processed = short_write ? 14 : size;
+    return 0;
+}
+int _usb_read(struct cgpu_info *cgpu, int ii, int ep, char *buf,
+              size_t size, int *processed, int timeout, const char *end,
+              enum usb_cmds cmd, bool once, bool cancellable)
+{
+    (void)cgpu; (void)ii; (void)ep; (void)timeout; (void)end;
+    (void)cmd; (void)once; (void)cancellable;
+    assert(size == 7);
+    if (last[1] == fail_id) { *processed = 0; return -1; }
+    uint8_t reply[] = {':', last[1], BAIKAL_SET_OPTION, 0, 0, '\r', '\n'};
+    if (bad_reply == 1) reply[1]++;
+    if (bad_reply == 2) reply[2]++;
+    memcpy(buf, reply, 7);
+    *processed = bad_reply == 3 ? 0 : 7;
+    return 0;
+}
+
+static void test_policy(void)
+{
+    int temps[] = {1,39,40,44,45,47,48,50,51,100};
+    int duties[] = {10,10,25,25,40,40,65,65,100,100};
+    for (unsigned i = 0; i < sizeof(temps)/sizeof(temps[0]); i++)
+        assert(baikal_fan_target(temps[i]) == duties[i]);
+    struct baikal_fan_policy p = {0};
+    assert(baikal_fan_next(&p, 10, 51, true, 100) == 100);
+    assert(baikal_fan_next(&p, 25, 39, true, 100) == 25);
+    assert(!p.cooling);
+    /* A warm excursion interrupts the continuous cooling requirement. */
+    assert(baikal_fan_next(&p, 65, 46, true, 400) == 65);
+    assert(baikal_fan_next(&p, 65, 47, true, 430) == 65);
+    assert(baikal_fan_next(&p, 65, 46, true, 450) == 65);
+    assert(baikal_fan_next(&p, 65, 46, true, 509) == 65);
+    assert(baikal_fan_next(&p, 65, 46, true, 510) == 40);
+    assert(baikal_fan_next(&p, 25, 38, true, 101) == 25);
+    assert(baikal_fan_next(&p, 25, 38, true, 160) == 25);
+    assert(baikal_fan_next(&p, 25, 38, true, 161) == 10);
+    assert(baikal_fan_next(&p, 100, 35, true, 200) == 100);
+    assert(baikal_fan_next(&p, 100, 35, true, 260) == 65);
+    assert(baikal_fan_next(&p, 65, 35, true, 261) == 65);
+    assert(baikal_fan_next(&p, 65, 35, false, 300) == 100);
+    assert(!p.cooling);
+}
+
+int main(void)
+{
+    test_policy();
+    struct baikal_info info = {0};
+    struct cgpu_info boards[3] = {0};
+    pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    char reply[1024];
+    info.miner_count = 3;
+    info.fanspeed = info.fan_requested = 100;
+    info.fan_applied_valid = true;
+    for (int i = 0; i < 3; i++) {
+        boards[i].miner_id = i;
+        boards[i].device_data = &info;
+        boards[i].mutex = &lock;
+        info.fan_boards[i] = &boards[i];
+        assert(baikal_setoption(&boards[i], 400, 0x34 + i, 55, 100));
+        info.miners[i].clock = 480;
+        info.miners[i].temperature_seen = fake_now;
+        info.miners[i].temperature_valid = true;
+        info.miners[i].temp = 35 + i;
+    }
+    writes = 0;
+    char *invalid[] = {"", "-1", "101", "10x", "1.5", "9999999999999999999999999"};
+    for (unsigned i = 0; i < sizeof(invalid)/sizeof(invalid[0]); i++)
+        assert(baikal_set_device(&boards[1], "fan", invalid[i], reply));
+    assert(writes == 0);
+    assert(!baikal_set_device(&boards[1], "fan", "10", reply));
+    assert(writes == 0 && info.fan_pending);
+    baikal_fan_tick(&boards[0], false);
+    assert(writes == 3 && info.fanspeed == 10 && !info.fan_auto);
+    for (int i = 0; i < 3; i++) {
+        assert(history[i][1] == i);
+        assert(history[i][6] == 2); /* Preserve requested 400 selector, not reported 480. */
+        assert(history[i][8] == 0x34 + i);
+        assert(history[i][10] == 55);
+        assert(history[i][12] == 10);
+    }
+    assert(!baikal_set_device(&boards[2], "fan-auto", "on", reply));
+    info.miners[1].temp = 51;
+    baikal_fan_tick(&boards[0], false);
+    assert(info.fanspeed == 100 && info.fan_hottest == 51);
+    info.miners[1].temp = 35;
+    info.miners[2].temperature_seen = fake_now - 15;
+    baikal_fan_tick(&boards[0], false);
+    assert(info.fanspeed == 100 && info.fan_hottest == -1);
+    info.miners[2].temperature_seen = fake_now;
+    info.miners[2].temperature_valid = false;
+    baikal_fan_tick(&boards[0], false);
+    assert(info.fanspeed == 100 && info.fan_hottest == -1);
+    info.miners[2].temperature_valid = true;
+    info.fan_boards[2] = NULL;
+    assert(!baikal_fan_apply_locked(&boards[0], 100));
+    assert(!info.fan_applied_valid);
+    info.fan_boards[2] = &boards[2];
+    for (int bad = 1; bad <= 3; bad++) {
+        bad_reply = bad;
+        assert(!baikal_fan_apply_locked(&boards[0], 25));
+        assert(!info.fan_applied_valid);
+    }
+    bad_reply = 0;
+    short_write = 1;
+    assert(!baikal_fan_apply_locked(&boards[0], 25));
+    short_write = 0;
+    /* A mid-broadcast failure must attempt the remaining board and then
+     * broadcast 100 to all three, leaving acknowledgement explicitly unknown. */
+    writes = 0;
+    fail_id = 1;
+    assert(!baikal_set_device(&boards[0], "fan", "25", reply));
+    baikal_fan_tick(&boards[0], false);
+    assert(writes == 6 && info.fan_fault && !info.fan_applied_valid);
+    assert(history[2][1] == 2);
+    for (int i = 3; i < 6; i++) assert(history[i][12] == 100);
+    fail_id = -1;
+    fake_now += 5;
+    for (int i = 0; i < 3; i++) info.miners[i].temperature_seen = fake_now;
+    baikal_fan_tick(&boards[0], false);
+    assert(info.fanspeed == 100 && info.fan_applied_valid && info.fan_fault);
+    assert(!baikal_set_device(&boards[0], "fan-reset", "yes", reply));
+    assert(!info.fan_fault);
+    fake_now += 16;
+    info.fan_fault = true;
+    assert(baikal_set_device(&boards[0], "fan-reset", "yes", reply));
+    /* The worker must apply stale-telemetry fallback without result polling. */
+    info.fan_fault = false;
+    info.fan_auto = true;
+    info.fanspeed = 10;
+    info.fan_applied_valid = true;
+    info.fan_retry_after = 0;
+    info.fan_stop = false;
+    pthread_t worker;
+    assert(!pthread_create(&worker, NULL, baikal_fan_worker, &boards[0]));
+    bool applied = false;
+    for (int attempt = 0; attempt < 100; attempt++) {
+        pthread_mutex_lock(&lock);
+        applied = info.fanspeed == 100;
+        if (applied) info.fan_stop = true;
+        pthread_mutex_unlock(&lock);
+        if (applied) break;
+        cgsleep_ms(1);
+    }
+    assert(applied);
+    assert(!pthread_join(worker, NULL));
+    pthread_mutex_destroy(&lock);
+    puts("Baikal fan policy and mocked USB driver tests passed");
+    return 0;
+}
