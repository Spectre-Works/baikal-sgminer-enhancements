+            !baikal_option_locked(board, miner->option_clock,
+                                  miner->option_mode, miner->option_cutoff, fan))
+            ok = false;
+    }
+    if (ok) {
+        info->fanspeed = fan;
+        info->fan_applied_valid = true;
+    }
+    return ok;
+}
+
+static void baikal_fan_tick(struct cgpu_info *baikal, bool transport_failed)
+{
+    struct baikal_info *info = baikal->device_data;
+    uint64_t now = baikal_fan_now();
+    bool valid = !transport_failed;
+    int hottest = 0, target, previous, i;
+    mutex_lock(baikal->mutex);
+    for (i = 0; i < info->miner_count; i++) {
+        struct miner_info *miner = &info->miners[i];
+        if (!info->fan_boards[i] || !miner->temperature_valid ||
+            now - miner->temperature_seen >= BAIKAL_FAN_STALE_SECONDS)
+            valid = false;
+        if (miner->temperature_valid && miner->temp > hottest)
+            hottest = miner->temp;
+    }
+    info->fan_hottest = valid ? hottest : -1;
+    if (info->fan_auto && info->fan_telemetry_bad != !valid) {
+        info->fan_telemetry_bad = !valid;
+        applog(valid ? LOG_NOTICE : LOG_WARNING,
+               "Baikal fan telemetry %s; hottest=%dC",
+               valid ? "recovered" : "missing/stale/invalid: forcing 100%", hottest);
+    }
+    if (transport_failed) info->fan_fault = true;
+    if (!info->fan_auto && !info->fan_pending && !info->fan_fault) {
+        mutex_unlock(baikal->mutex);
+        return;
+    }
+    previous = info->fanspeed;
+    target = info->fan_requested;
+    if (info->fan_auto)
+        target = baikal_fan_next(&info->fan_policy, previous, hottest, valid, now);
+    if (info->fan_fault || (info->fan_auto && !valid)) target = 100;
+    if (info->fan_auto || info->fan_fault) info->fan_requested = target;
+    if (now < info->fan_retry_after) {
+        mutex_unlock(baikal->mutex);
+        return;
+    }
+    if (info->fan_pending || !info->fan_applied_valid || target != previous) {
+        bool ok = baikal_fan_apply_locked(baikal, target);
+        if (!ok) {
+            info->fan_fault = true;
+            info->fan_policy.cooling = false;
+            ok = baikal_fan_apply_locked(baikal, 100);
+            info->fan_retry_after = now + 5;
+            applog(LOG_ERR, "Baikal fan update failed; 100%% fallback %s; clock/algorithm/cutoff preserved",
+                   ok ? "acknowledged" : "unconfirmed (USB unavailable)");
+        } else {
+            applog(LOG_NOTICE, "Baikal fan: %s hottest=%dC duty=%d->%d%% telemetry=%s",
+                   info->fan_fault ? "fault" : (info->fan_auto ? "auto" : "manual"),
+                   hottest, previous, target, valid ? "valid" : "invalid");
+        }
+    }
+    info->fan_pending = false;
+    mutex_unlock(baikal->mutex);
+}
+
+static char *baikal_set_device(struct cgpu_info *baikal, char *option,
+                             char *setting, char *replybuf)
+{
+    struct baikal_info *info = baikal->device_data;
+    char *end;
+    long fan;
+    if (!strcasecmp(option, "help")) {
+        sprintf(replybuf, "fan: 0-100 (manual); fan-auto: on/off; fan-reset: yes (clear USB fault after recovery). Changes queued; query stats for acknowledgement.");
+        return replybuf;
+    }
+    if (!strcasecmp(option, "fan-auto")) {
+        if (!setting || (strcasecmp(setting, "on") && strcasecmp(setting, "off")))
+            return "fan-auto must be on or off";
+        mutex_lock(baikal->mutex);
+        info->fan_auto = !strcasecmp(setting, "on");
+        info->fan_requested = info->fanspeed;
+        info->fan_pending = true;
+        info->fan_policy.cooling = false;
+        mutex_unlock(baikal->mutex);
+        return NULL;
+    }
+    if (!strcasecmp(option, "fan-reset")) {
+        if (!setting || strcasecmp(setting, "yes")) return "fan-reset must be yes";
+        mutex_lock(baikal->mutex);
+        bool healthy = info->fan_applied_valid && info->fan_hottest > 0 && info->fan_hottest < 51;
+        uint64_t now = baikal_fan_now();
+        for (int i = 0; i < info->miner_count; i++)
+            if (!info->fan_boards[i] || !info->miners[i].temperature_valid ||
+                now - info->miners[i].temperature_seen >= BAIKAL_FAN_STALE_SECONDS)
+                healthy = false;
+        if (!healthy) {
+            mutex_unlock(baikal->mutex);
+            return "Fresh healthy telemetry and an acknowledged fan setting required";
+        }
+        info->fan_fault = false;
+        info->fan_pending = true;
+        mutex_unlock(baikal->mutex);
+        return NULL;
+    }
+    if (strcasecmp(option, "fan")) return "Unknown option";
+    if (!setting || !*setting) return "Fan must be an integer from 0 to 100";
+    errno = 0;
+    fan = strtol(setting, &end, 10);
+    if (errno || end == setting || *end || fan < 0 || fan > 100)
+        return "Fan must be an integer from 0 to 100";
+    mutex_lock(baikal->mutex);
+    info->fan_auto = false;
+    info->fan_requested = fan;
+    info->fan_pending = true;
+    info->fan_policy.cooling = false;
+    mutex_unlock(baikal->mutex);
+    return NULL;
+}
+
+/* Independent of pool work availability, but all USB traffic remains
+ * serialized with mining by the controller's existing mutex. */
+static void *baikal_fan_worker(void *arg)
+{
+    struct cgpu_info *baikal = arg;
+    struct baikal_info *info = baikal->device_data;
+    for (;;) {
+        mutex_lock(baikal->mutex);
+        bool stop = info->fan_stop;
+        mutex_unlock(baikal->mutex);
+        if (stop) break;
+        baikal_fan_tick(baikal, false);
+        cgsleep_ms(1000);
+    }
+    return NULL;
 }
 
 
