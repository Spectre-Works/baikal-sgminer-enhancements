+static char *baikal_set_device(struct cgpu_info *baikal, char *option, char *setting, char *replybuf)
+{
+    struct baikal_info *info = baikal->device_data;
+    char *end;
+    long fanspeed;
+    int i;
+
+    if (strcasecmp(option, "help") == 0) {
+        sprintf(replybuf, "fan: set fan speed (0-100)");
+        return replybuf;
+    }
+
+    if (strcasecmp(option, "fan") != 0) {
+        return "Unknown option";
+    }
+
+    if (setting == NULL || *setting == '\0') {
+        return "Fan must be an integer from 0 to 100";
+    }
+
+    errno = 0;
+    fanspeed = strtol(setting, &end, 10);
+    if (errno != 0 || end == setting || *end != '\0' ||
+        fanspeed < 0 || fanspeed > BAIKAL_FANSPEED_MAX) {
+        return "Fan must be an integer from 0 to 100";
+    }
+
+    /* All logical miners on one controller share baikal_info.  Send the
+     * complete option tuple to each detected miner so changing the fan does
+     * not overwrite that board's current clock, algorithm, or cutoff. */
+    for (i = 0; i < total_devices; i++) {
+        struct cgpu_info *board = get_devices(i);
+        struct miner_info *miner;
+
+        if (board == NULL || board->drv->drv_id != DRIVER_baikalu ||
+            board->device_data != info) {
+            continue;
+        }
+
+        miner = &info->miners[board->miner_id];
+        if (!baikal_setoption(board, miner->clock,
+                    to_baikal_algorithm(board->algorithm.type),
+                    info->cutofftemp, (uint8_t)fanspeed)) {
+            return "Failed to set fan speed on all Baikal boards";
+        }
+    }
+
+    info->fanspeed = (uint8_t)fanspeed;
+    return NULL;
+}
